{
  "name": "demo",
  "private": true,
  "description": "Demo Web",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "libs/*",
    "tools/*"
  ],
  "scripts": {
    "api": "pnpm --filter @demo/api",
    "format": "oxfmt --write .",
    "prepare": "lefthook install",
    "formatcheck": "oxfmt --check .",
    "generate-api": "pnpm api generate",
    "lint": "pnpm lint-es && pnpm lint-css",
    "lint-css": "stylelint '**/*.css' --cache",
    "lint-es": "oxlint .",
    "lintfix": "oxlint --fix . && pnpm lint-css --fix",
    "new-version": "lerna version",
    "start-storybook": "lerna run start-storybook --stream",
    "test": "lerna run test --stream",
    "test-ci": "lerna run test-ci --stream",
    "typecheck": "lerna run typecheck --no-bail --stream",
    "vrtest-regression": "reg-suit run",
    "ui": "pnpm --filter @demo/ui",
    "web": "pnpm --filter @demo/web"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.4",
    "lefthook": "^2.1.2",
    "lerna": "^10.0.1",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.79.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reg-local-publisher-plugin": "workspace:*",
    "reg-notify-github-plugin": "^0.14.5",
    "reg-suit": "0.14.5",
    "rimraf": "^6.1.3",
    "stylelint": "^17.14.1",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-prettier": "^3.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "*",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": "^22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.34.5"
}
